        "<h1>\n",
        "  <b>Data preperation</b></h1>\n",
        " <h5> > Encode data into numerical representation (tensors) <br> > Build model to learn patterns that representation\n",
        " </h5>"
      ],
      "metadata": {
        "id": "rN9RontqB7fb"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "<b> Create some data </b>"
      ],
      "metadata": {
        "id": "CAFmgc0RDVop"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#weights biases\n",
        "weight = 0.5\n",
        "bias = 0.2\n",
        "\n",
        "#linearly increase\n",
        "start = 0\n",
        "end = 1\n",
        "step = 0.02\n",
        "X = torch.arange(start, end, step).unsqueeze(dim=1)\n",
        "y = weight * X + bias\n"
      ],
      "metadata": {
        "id": "Via9H0jJDVKT"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "<b>Lets visualize it now</b>"
      ],
      "metadata": {
        "id": "xCXxSa_2EVw5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "y_vals = y.permute([1,0]).detach().cpu().numpy()[0]\n",
        "x_vals = np.arange(0,1,0.02)\n",
        "plt.plot(x_vals, y_vals)\n",
        "plt.xlabel(\"step\")\n",
        "plt.ylabel(\"value\")\n",
        "plt.xlim(0, 1)\n",
        "plt.ylim(0, 1)\n",
        "plt.show()\n"
      ],
